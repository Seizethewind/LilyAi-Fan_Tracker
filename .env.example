# Copy to .env for local runs. Never commit the real file.

# --- Discord ---
DISCORD_TOKEN=your-discord-bot-token
# Your server's ID. Optional, but makes slash commands appear instantly instead of within ~1 hour.
DISCORD_GUILD_ID=

# --- uma.moe ---
UMAMOE_API_KEY=your-umamoe-api-key
CLUB1_ID=974470619
CLUB2_ID=325938032
CLUB1_LABEL=Club 1
CLUB2_LABEL=Club 2
SYNC_INTERVAL_SECONDS=300

# --- Storage ---
# Required on Render (its filesystem is wiped on restart).
TURSO_DATABASE_URL=libsql://your-database-your-org.turso.io
TURSO_AUTH_TOKEN=your-turso-token
# Local fallback when the two Turso values are not set.
SQLITE_PATH=fantracker.db

# --- API for the LilyAi app ---
# Send as:  Authorization: Bearer <key>
API_READ_KEY=generate-a-long-random-string
API_WRITE_KEY=generate-a-different-long-random-string
# Comma-separated browser origins allowed to call the API. Leave empty for none.
CORS_ORIGINS=

# --- AI replies when the bot is @mentioned (optional) ---
# Your self-hosted router, OpenAI-compatible. The URL ends in /v1. Leave both empty to keep this off.
AI_ROUTER_URL=https://your-router-host/v1
AI_ROUTER_API_KEY=your-router-api-key
AI_MODEL=auto
# Seconds one person must wait between questions.
AI_USER_COOLDOWN_SECONDS=10

# --- Daily fan quota warning (optional) ---
# Once a day the bot posts the members still under QUOTA_FANS fans today. Leave the channel empty to keep this off.
# 22 UTC is 6:00 AM in the Philippines, two hours before the 00:00 UTC reset. The AI router writes the opening
# lines when it is configured; the list of names is always taken from the saved data.
QUOTA_CHANNEL_ID=
QUOTA_FANS=5000000
QUOTA_HOUR_UTC=22

# --- Keep-alive ---
# On Render the ping URL is taken from RENDER_EXTERNAL_URL automatically.
SELF_PING_URL=
SELF_PING_INTERVAL_SECONDS=300
